# Copy to .env.local and fill in. Leave BOTH Supabase values empty to run the
# browser-only demo mode. Only browser-safe values belong here (VITE_ = public).

# Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Supabase PUBLISHABLE (anon) key — safe in the browser only because RLS is on.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public URL where this app is served (auth redirects + customer links).
VITE_APP_URL=

# ── Edge Function secrets: set with `supabase secrets set`, NEVER in this file ──
# SUPABASE_SERVICE_ROLE_KEY   (provided automatically to Edge Functions)
# TRACE_LINK_SECRET           (random, >= 32 chars; rotating it invalidates customer links)
# APP_URL                     (same as VITE_APP_URL)
# ALLOWED_ORIGINS             (comma-separated, e.g. https://trace.example.org)
